NODE_ENV=development
PORT=8000

# MongoDB connection string (e.g., mongodb+srv://user:password@cluster.mongodb.net/)
MONGO_CONNECTION_STRING=

# GitHub OAuth credentials (get these from https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Session security (in production, use a long random string from a secure generator)
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Frontend URL (for CORS and redirect after login)
CLIENT_URL=http://localhost:5173
